# Server-only SMTP settings for /api/contact. Never prefix these with NEXT_PUBLIC_.
# Local dev: point at Mailhog (docker compose up) -> SMTP_HOST=localhost SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_ADDRESS=
# Optional: address submissions are sent from (defaults to SMTP_USER)
CONTACT_FROM_ADDRESS=
# Set to "production" only on Haley's final domain; anything else adds noindex.
SITE_ENV=staging
# Public Mapbox token for the Contact page map (restrict it to the site's URLs in Mapbox).
NEXT_PUBLIC_MAPBOX_TOKEN=
