# Server-only SMTP settings for /api/contact. Never prefix these with NEXT_PUBLIC_.
# Local dev: point at Mailhog (docker compose up) -> SMTP_HOST=localhost SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_ADDRESS=
# Optional: address submissions are sent from (defaults to SMTP_USER)
CONTACT_FROM_ADDRESS=
# Set to "production" only on Haley's final domain; anything else adds noindex.
SITE_ENV=staging

# ---- Portfolio admin (/admin). Full setup and hosting notes: docs/ADMIN.md ----
# Any PostgreSQL connection string (Vercel's Neon integration sets this automatically).
DATABASE_URL=
# Long random value that signs admin sessions (32+ characters).
SESSION_SECRET=
# The first admin, created on first sign-in. Remove ADMIN_PASSWORD once signed in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Photo storage: Vercel Blob (set automatically when a Blob store is connected)...
BLOB_READ_WRITE_TOKEN=
# ...or any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
