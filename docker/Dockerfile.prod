# Production: a single-stage Node image. The /api/contact route needs a running server,
# so this serves both the statically generated pages and that one API route via `next start`.
# (A pure static export could use nginx alone; owning the contact form is the tradeoff.)
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build && npm prune --omit=dev
EXPOSE 3000
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
